#!/usr/bin/env bash

echo "Running automated tests..."

passed=0
failed=0

run_test() {
    test_name=$1
    command=$2
    expected=$3

    output=$(eval "$command" 2>&1)

    if [[ "$output" == *"$expected"* ]]
    then
        echo "PASS: $test_name"
        passed=$((passed + 1))
    else
        echo "FAIL: $test_name"
        echo "Expected: $expected"
        echo "Got: $output"
        failed=$((failed + 1))
    fi
}

# -----------------------------------------
# Test 1: No input file provided
# -----------------------------------------

run_test \
"No input file" \
"./clean" \
"ERROR: No input CSV file provided"

# -----------------------------------------
# Test 2: Input file not found
# -----------------------------------------

run_test \
"Missing input file" \
"./clean missing.csv" \
"ERROR: Input file not found in the current directory"

# -----------------------------------------
# Test 3: Incorrect file extension
# -----------------------------------------

touch tests/test.txt

run_test \
"Invalid file extension" \
"./clean tests/test.txt" \
"ERROR: Input file expected in a CSV format"

# -----------------------------------------
# Test 4: Empty CSV file
# -----------------------------------------

touch tests/empty.csv

run_test \
"Empty CSV file" \
"./clean tests/empty.csv" \
"ERROR: Empty file provided"

# -----------------------------------------
# Test 5: Incorrect header field count
# -----------------------------------------

cat > tests/bad_header.csv <<EOF
a,b,c
1,2,3
EOF

run_test \
"Incorrect header fields" \
"./clean tests/bad_header.csv" \
"ERROR: Expected 7 columns in the header"

# -----------------------------------------
# Test 6: Successful clean execution
# -----------------------------------------

cat > tests/sample.csv <<EOF
video_id,publish_date,views,likes,dislikes,comments_disabled,ratings_disabled
id1,2009-09-18T15:36:33.000Z,100,10,5,FALSE,FALSE
id2,2009-09-18T15:36:33.000Z,100,0,5,FALSE,FALSE
id3,2009-09-18T15:36:33.000Z,100,10,0,FALSE,FALSE
id4,2009-09-18T15:36:33.000Z,100,10,5,FALSE,FALSE
id4,2009-09-18T15:36:33.000Z,100,10,5,FALSE,FALSE
,2009-09-18T15:36:33.000Z,100,10,5,FALSE,FALSE
EOF

./clean tests/sample.csv

if [[ -f trending_videos_clean.csv ]]
then
    echo "PASS: Output file created"
    passed=$((passed + 1))
else
    echo "FAIL: Output file not created"
    failed=$((failed + 1))
fi

# -----------------------------------------
# Test 7: Header contains 6 columns
# -----------------------------------------

header_fields=$(head -n 1 trending_videos_clean.csv | awk -F',' '{print NF}')

if [[ "$header_fields" -eq 6 ]]
then
    echo "PASS: Header contains 6 fields"
    passed=$((passed + 1))
else
    echo "FAIL: Header field count incorrect"
    failed=$((failed + 1))
fi

# -----------------------------------------
# Test 8: ratings_disabled removed
# -----------------------------------------

if head -n 1 trending_videos_clean.csv | grep -q "ratings_disabled"
then
    echo "FAIL: ratings_disabled column still exists"
    failed=$((failed + 1))
else
    echo "PASS: ratings_disabled column removed"
    passed=$((passed + 1))
fi

# -----------------------------------------
# Test 9: publish_date cleaned
# -----------------------------------------

if grep -q "T15:36:33.000Z" trending_videos_clean.csv
then
    echo "FAIL: publish_date still contains time"
    failed=$((failed + 1))
else
    echo "PASS: publish_date cleaned"
    passed=$((passed + 1))
fi

# -----------------------------------------
# Test 10: Duplicate rows removed
# -----------------------------------------

duplicates=$(sort trending_videos_clean.csv | uniq -d)

if [[ -n "$duplicates" ]]
then
    echo "FAIL: Duplicate rows found"
    failed=$((failed + 1))
else
    echo "PASS: Duplicate rows removed"
    passed=$((passed + 1))
fi

# -----------------------------------------
# Test 11: Rows with zero likes/dislikes removed
# -----------------------------------------

if grep -q "^id2," trending_videos_clean.csv || \
   grep -q "^id3," trending_videos_clean.csv
then
    echo "FAIL: Rows with zero likes/dislikes still exist"
    failed=$((failed + 1))
else
    echo "PASS: Zero likes/dislikes rows removed"
    passed=$((passed + 1))
fi

# -----------------------------------------
# Test 12: Rows with missing video_id removed
# -----------------------------------------

if grep -q "^," trending_videos_clean.csv
then
    echo "FAIL: Missing video_id rows still exist"
    failed=$((failed + 1))
else
    echo "PASS: Missing video_id rows removed"
    passed=$((passed + 1))
fi

# -----------------------------------------
# Test 13: Rows with empty fields removed
# -----------------------------------------

cat > tests/empty_fields.csv <<EOF
video_id,publish_date,views,likes,dislikes,comments_disabled,ratings_disabled
id1,,100,10,5,FALSE,FALSE
EOF

./clean tests/empty_fields.csv

data_rows=$(tail -n +2 trending_videos_clean.csv | wc -l)

if [[ "$data_rows" -eq 0 ]]
then
    echo "PASS: Rows with empty fields removed"
    passed=$((passed + 1))
else
    echo "FAIL: Rows with empty fields still exist"
    failed=$((failed + 1))
fi


# -----------------------------------------
# Test 14: ratings_disabled column fully removed
# -----------------------------------------

header=$(head -n 1 trending_videos_clean.csv)

if [[ "$header" == *"ratings_disabled"* ]]
then
    echo "FAIL: ratings_disabled still present in header"
    failed=$((failed + 1))
else
    echo "PASS: ratings_disabled fully removed"
    passed=$((passed + 1))
fi


# -----------------------------------------
# Test 15: Output contains only valid rows
# -----------------------------------------

cat > tests/valid_rows.csv <<EOF
video_id,publish_date,views,likes,dislikes,comments_disabled,ratings_disabled
id1,2009-09-18T15:36:33.000Z,100,10,5,FALSE,FALSE
id2,2009-09-18T15:36:33.000Z,200,20,10,TRUE,FALSE
EOF

./clean tests/valid_rows.csv

data_rows=$(tail -n +2 trending_videos_clean.csv | wc -l)

if [[ "$data_rows" -eq 2 ]]
then
    echo "PASS: Valid rows preserved"
    passed=$((passed + 1))
else
    echo "FAIL: Valid rows incorrectly removed"
    failed=$((failed + 1))
fi


# -----------------------------------------
# Test 16: publish_date format cleaned correctly
# -----------------------------------------

if grep -Eq '[0-9]{4}-[0-9]{2}-[0-9]{2}T' trending_videos_clean.csv
then
    echo "FAIL: publish_date format incorrect"
    failed=$((failed + 1))
else
    echo "PASS: publish_date format cleaned correctly"
    passed=$((passed + 1))
fi


# -----------------------------------------
# Test 17: Output file contains exactly 6 columns
# -----------------------------------------

invalid_columns=$(awk -F',' 'NF != 6' trending_videos_clean.csv)

if [[ -n "$invalid_columns" ]]
then
    echo "FAIL: Some rows do not contain 6 columns"
    failed=$((failed + 1))
else
    echo "PASS: All rows contain 6 columns"
    passed=$((passed + 1))
fi


# -----------------------------------------
# Test 18: Duplicate removal preserves one copy
# -----------------------------------------

cat > tests/duplicates.csv <<EOF
video_id,publish_date,views,likes,dislikes,comments_disabled,ratings_disabled
id1,2009-09-18T15:36:33.000Z,100,10,5,FALSE,FALSE
id1,2009-09-18T15:36:33.000Z,100,10,5,FALSE,FALSE
EOF

./clean tests/duplicates.csv

data_rows=$(tail -n +2 trending_videos_clean.csv | wc -l)

if [[ "$data_rows" -eq 1 ]]
then
    echo "PASS: Duplicate rows removed correctly"
    passed=$((passed + 1))
else
    echo "FAIL: Duplicate rows not handled correctly"
    failed=$((failed + 1))
fi


# -----------------------------------------
# Test 19: Output file generated successfully
# -----------------------------------------

if [[ -s trending_videos_clean.csv ]]
then
    echo "PASS: Output file generated successfully"
    passed=$((passed + 1))
else
    echo "FAIL: Output file generation failed"
    failed=$((failed + 1))
fi

# -----------------------------------------
# Test 20: Header with more than 7 fields
# -----------------------------------------

cat > tests/extra_header.csv <<EOF
a,b,c,d,e,f,g,h
1,2,3,4,5,6,7,8
EOF

run_test \
"Header with extra fields" \
"./clean tests/extra_header.csv" \
"ERROR: Expected 7 columns in the header"

# -----------------------------------------
# Test 21: Valid CSV content with invalid extension
# -----------------------------------------

cat > tests/fake.txt <<EOF
a,b,c,d,e,f,g
1,2,3,4,5,6,7
EOF

run_test \
"CSV content but invalid extension" \
"./clean tests/fake.txt" \
"ERROR: Input file expected in a CSV format"

# -----------------------------------------
# Test 22: File with only header (no data rows)
# -----------------------------------------

cat > tests/header_only.csv <<EOF
video_id,publish_date,views,likes,dislikes,comments_disabled,ratings_disabled
EOF

run_test \
"Header-only file (no data rows)" \
"./clean tests/header_only.csv" \
"ERROR: No data rows found in the input file"

# -----------------------------------------
# Test 23: Multiple duplicate rows
# -----------------------------------------

cat > tests/many_duplicates.csv <<EOF
video_id,publish_date,views,likes,dislikes,comments_disabled,ratings_disabled
id1,2009-09-18T15:36:33.000Z,100,10,5,FALSE,FALSE
id1,2009-09-18T15:36:33.000Z,100,10,5,FALSE,FALSE
id1,2009-09-18T15:36:33.000Z,100,10,5,FALSE,FALSE
EOF

./clean tests/many_duplicates.csv

rows=$(tail -n +2 trending_videos_clean.csv | wc -l)

if [[ "$rows" -eq 1 ]]
then
    echo "PASS: Multiple duplicates removed correctly"
    passed=$((passed + 1))
else
    echo "FAIL: Multiple duplicates not removed"
    failed=$((failed + 1))
fi

# -----------------------------------------
# Test 24: Rows with blank fields
# -----------------------------------------

cat > tests/blank_fields.csv <<EOF
video_id,publish_date,views,likes,dislikes,comments_disabled,ratings_disabled
id1,,100,10,5,FALSE,FALSE
EOF

./clean tests/blank_fields.csv

rows=$(tail -n +2 trending_videos_clean.csv | wc -l)

if [[ "$rows" -eq 0 ]]
then
    echo "PASS: Blank field rows removed"
    passed=$((passed + 1))
else
    echo "FAIL: Blank field rows still exist"
    failed=$((failed + 1))
fi

# -----------------------------------------
# Test 25: ratings_disabled column fully removed from all rows
# -----------------------------------------

invalid=$(awk -F',' 'NF != 6' trending_videos_clean.csv)

if [[ -n "$invalid" ]]
then
    echo "FAIL: Some rows still contain incorrect columns"
    failed=$((failed + 1))
else
    echo "PASS: All rows contain exactly 6 columns"
    passed=$((passed + 1))
fi

# -----------------------------------------
# Test 26: Valid rows remain unchanged
# -----------------------------------------

cat > tests/valid_rows_check.csv <<EOF
video_id,publish_date,views,likes,dislikes,comments_disabled,ratings_disabled
id1,2009-09-18T15:36:33.000Z,100,10,5,FALSE,FALSE
EOF

./clean tests/valid_rows_check.csv

if grep -q "^id1,2009-09-18,100,10,5,FALSE$" trending_videos_clean.csv
then
    echo "PASS: Valid rows preserved correctly"
    passed=$((passed + 1))
else
    echo "FAIL: Valid rows modified incorrectly"
    failed=$((failed + 1))
fi

# -----------------------------------------
# Final Results
# -----------------------------------------

echo ""
echo "Tests Passed: $passed"
echo "Tests Failed: $failed"

if [[ "$failed" -gt 0 ]]
then
    exit 1
fi

echo "All tests passed successfully."